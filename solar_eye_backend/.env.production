# =============================================================================
# Solar Eye Backend - Production Environment Configuration
# Cloud Run 배포용 환경 설정 파일
# =============================================================================

# Application Settings
APP_NAME=solar-eye-backend
APP_ENV=production
DEBUG=false
SECRET_KEY=your-production-secret-key-change-this-to-a-random-string

# Server Settings
HOST=0.0.0.0
PORT=8080
WORKERS=1

# =============================================================================
# Database Settings (Cloud SQL - PostgreSQL)
# =============================================================================
# Cloud SQL 공개 IP 연결
DATABASE_URL=postgresql+asyncpg://postgres:rare7979@34.172.168.112:5432/solar_eye
POSTGRES_USER=postgres
POSTGRES_PASSWORD=rare7979
POSTGRES_DB=solar_eye
POSTGRES_HOST=34.172.168.112
POSTGRES_PORT=5432

# =============================================================================
# Redis Settings (Cloud Run에서는 Redis 없이 운영 가능)
# =============================================================================
# Redis를 사용하지 않으면 빈 값으로 두세요
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# Firebase Settings
# =============================================================================
# Cloud Run에서는 ADC(Application Default Credentials)를 사용하므로
# credentials path는 비워두거나 knu-team-01 프로젝트 ID만 설정
FIREBASE_PROJECT_ID=knu-team-01
FIREBASE_CREDENTIALS_PATH=

# =============================================================================
# Weather API Settings (기상청)
# =============================================================================
WEATHER_API_KEY=43d4e6ebea58644e3ac225984dace94c42327b36fbb84c35bc6e4a34d366f235
WEATHER_API_BASE_URL=http://apis.data.go.kr/1360000/VilageFcstInfoService_2.0

# =============================================================================
# AI Model Settings
# =============================================================================
# GCS 마운트 경로: /app/ai/models (Cloud Run에서 자동 설정)
AI_MODEL_PATH=/app/ai/models/
USE_GPU=true
GPU_DEVICE_ID=0
FP16_ENABLED=true

# =============================================================================
# CORS Settings
# =============================================================================
# Cloud Run URL 및 프론트엔드 URL 허용
CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false

# =============================================================================
# Logging Settings
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE_PATH=

# =============================================================================
# Storage Settings
# =============================================================================
UPLOAD_DIR=uploads/
SNAPSHOT_DIR=snapshots/
MAX_UPLOAD_SIZE=104857600
