# Git
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.eggs/
*.egg-info/
*.egg

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Environment
.env
.env.local
.env.*.local

# Logs
logs/
*.log

# Documentation
*.md
!README.md
docs/

# Tests
tests/

# Alembic
alembic/versions/*.py
!alembic/versions/__init__.py

# Uploads (created at runtime)
uploads/
snapshots/

# Local development files
